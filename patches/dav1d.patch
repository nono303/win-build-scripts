diff --git a/meson.build b/meson.build
index accc0cde..e340d3c6 100644
--- a/meson.build
+++ b/meson.build
@@ -28,7 +28,7 @@ project('dav1d', ['c'],
                       'warning_level=2',
                       'buildtype=release',
                       'b_ndebug=if-release'],
-    meson_version: '>= 0.54.0')
+    meson_version: '>= 1.3.0')
 
 dav1d_src_root = meson.current_source_dir()
 cc = meson.get_compiler('c')
@@ -276,7 +276,9 @@ cdata.set10('HAVE_C11_GENERIC', cc.compiles('int x = _Generic(0, default: 0);',
 if cc.has_argument('-fvisibility=hidden')
     add_project_arguments('-fvisibility=hidden', language: 'c')
 else
-    warning('Compiler does not support -fvisibility=hidden, all symbols will be public!')
+    if cc.get_id() != 'msvc'
+        warning('Compiler does not support -fvisibility=hidden, all symbols will be public!')
+    endif
 endif
 
 # Compiler flags that should be set
@@ -507,8 +509,10 @@ if host_machine.cpu_family().startswith('x86')
     cdata_asm.set10('ARCH_X86_32', host_machine.cpu_family() == 'x86')
     cdata_asm.set10('PIC', true)
 
-    # Convert SSE asm into (128-bit) AVX when compiler flags are set to use AVX instructions
-    cdata_asm.set10('FORCE_VEX_ENCODING', cc.get_define('__AVX__').strip() != '')
+    if cc.has_define('__AVX__') 
+        # Convert SSE asm into (128-bit) AVX when compiler flags are set to use AVX instructions
+        cdata_asm.set10('FORCE_VEX_ENCODING', cc.get_define('__AVX__').strip() != '')
+    endif
 endif
 
 cdata.set10('ARCH_PPC64LE', host_machine.cpu() == 'ppc64le')
