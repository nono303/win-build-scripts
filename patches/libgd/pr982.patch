+	}
+
+	if (!_gdValidateCopyRectBounds(dst, src, (int)dstX, (int)dstY, srcX, srcY, srcW, srcH)) {
+		return;
+	}
+
 	int x, y;
 	if (!dst->trueColor) {
 		gdImageCopyResized (dst, src, dstX, dstY, srcX, srcY, dstW, dstH, srcW, srcH);
