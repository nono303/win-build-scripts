@@ -3323,6 +3368,14 @@ BGD_DECLARE(void) gdImageCopyResized (gdImagePtr dst, gdImagePtr src, int dstX,
 									  int srcX, int srcY, int dstW, int dstH, int srcW,
 									  int srcH)
 {
+	if (!_gdValidateCopyRectBounds(dst, src, dstX, dstY, srcX, srcY, srcW, srcH)) {
