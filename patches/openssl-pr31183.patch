 crypto/modes/asm/aesni-gcm-x86_64.pl   | 6 +++---
 crypto/modes/asm/ghash-parisc.pl       | 2 +-
 crypto/modes/asm/ghash-x86_64.pl       | 6 +++---
 crypto/pariscid.pl                     | 2 +-
 crypto/perlasm/x86_64-xlate.pl         | 6 +++---
 crypto/poly1305/asm/poly1305-x86.pl    | 6 +++---
 crypto/poly1305/asm/poly1305-x86_64.pl | 6 +++---
